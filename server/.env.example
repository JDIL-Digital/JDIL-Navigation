SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here
PORT=3001
EMAIL_USER=akshay.manjramkar@jindalmumbai.com
EMAIL_PASS=your_gmail_app_password

# ── Alert safety switches ──────────────────────────────────────────────────────
# Master kill switch for the escalation email system. Must be explicitly set to
# 'true' for any alert email to be sent. When false/unset, the stale checker
# still updates is_stale/is_delivery_stale flags and logs what it WOULD have
# sent, but sends nothing.
ALERTS_ENABLED=false

# Testing safety: when set, ALL summary emails are rerouted to this address
# instead of the real recipients (originals are logged for verification).
# Leave unset in production.
TEST_RECIPIENT_OVERRIDE=akshay.manjramkar@jindalmumbai.com

# ── Business Central (BC) OAuth — client-credentials flow ────────────────────────
# From the Azure app registration used for the Business Central API.
# Required for GET /api/admin/bc-integration/test-auth.
BC_TENANT_ID=your_azure_ad_tenant_id
BC_CLIENT_ID=your_app_registration_client_id
BC_CLIENT_SECRET=your_app_registration_client_secret
# BC environment name (e.g. Production / Sandbox) and company GUID — required for
# the data-fetch test (GET /api/admin/bc-integration/test-fetch).
BC_ENVIRONMENT=your_bc_environment_name
BC_COMPANY_ID=your_bc_company_guid
# Future kill switch for PROMOTING staged BC rows into po_orders (write to
# production). Not yet used — staging-only sync ignores it. Keep false until the
# promotion phase is built and validated.
BC_SYNC_ENABLED=false
