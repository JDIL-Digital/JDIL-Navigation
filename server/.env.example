SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here
PORT=3001
EMAIL_USER=akshay.manjramkar@jindalmumbai.com
EMAIL_PASS=your_gmail_app_password

# ── Alert safety switches ──────────────────────────────────────────────────────
# Master kill switch for the escalation email system. Must be explicitly set to
# 'true' for any alert email to be sent. When false/unset, the stale checker
# still updates is_stale/is_delivery_stale flags and logs what it WOULD have
# sent, but sends nothing.
ALERTS_ENABLED=false

# Testing safety: when set, ALL summary emails are rerouted to this address
# instead of the real recipients (originals are logged for verification).
# Leave unset in production.
TEST_RECIPIENT_OVERRIDE=akshay.manjramkar@jindalmumbai.com
